{
    "name": "invoiceplane/invoiceplane",
    "description": "InvoicePlane is a self-hosted open source application for managing your invoices, clients and payments",
    "homepage": "https://invoiceplane.com",
    "license": "MIT",
    "type": "project",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "require": {
        "php": ">=8.2",
        "endroid/qr-code": "^6.0",
        "ezyang/htmlpurifier": "^4.19",
        "guzzlehttp/guzzle": "^8.2",
        "moneyphp/money": "^4.9",
        "mpdf/mpdf": "^8.3.1",
        "phpmailer/phpmailer": "^7.1",
        "pocketarc/codeigniter": "^3.4.4",
        "setasign/fpdf": "^1.9",
        "setasign/fpdi": "^2.6.8",
        "smhg/sepa-qr-data": "^3.0",
        "stripe/stripe-php": "^21.3",
        "symfony/polyfill-mbstring": "^1.31",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "filp/whoops": "^2.18.4",
        "laravel/pint": "^1.30.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6.6",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/var-dumper": "^7.4"
    },
    "scripts": {
        "check": [
            "rector",
            "phpcs",
            "pint"
        ],
        "rector": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/rector process"
        ],
        "phpcs": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpcbf -p --standard=phpcs.xml"
        ],
        "pint": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/pint"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit"
        ]
    }
}
