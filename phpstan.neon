includes:
    - phpstan-baseline.neon

parameters:
    tmpDir: null
    level: 0
    paths:
        - application/modules/

    # CI3 loads module controllers/models and core traits via its own loader, not
    # an autoloader. Scanning these lets PHPStan discover the real class/trait
    # definitions so cross-module references resolve.
    scanDirectories:
        - application/modules
        - application/core
        - application/libraries
        - application/third_party/MX
        - vendor/pocketarc/codeigniter/system/core

    # CI3 has no PSR-4 autoloading/classmap. This bootstrap defines the framework
    # path constants and loads every application helper so their functions are
    # known to static analysis (kills the bulk of "function not found" noise).
    bootstrapFiles:
        - tests/Support/phpstan-bootstrap.php

    # Stub-only signature file for CI3 system functions (site_url, redirect,
    # log_message, lang, …). Registered as stubFiles rather than loaded via
    # bootstrapFiles so PHPStan treats them as pure signature declarations.
    stubFiles:
        - tests/Support/phpstan-ci-stubs.php

    ignoreErrors:
        # CI3 magic loading: controllers/models access framework services and
        # sub-models as dynamic properties ($this->db, $this->load, $this->input,
        # $this->mdl_*). These cannot be resolved statically without full stubs.
        -
            identifier: property.notFound
            path: application/modules/*

        # Sub-models and library methods are resolved dynamically by CI3's loader.
        -
            identifier: method.notFound
            path: application/modules/*

        # Base controllers/models (Admin_Controller, MY_Model, Response_Model, …)
        # are registered by CI3's HMVC loader, not autoloaded.
        -
            identifier: class.extendsUnknownClass
            paths:
                - application/modules/*
                - application/core/*

        # CI3 is case-insensitive when loading classes via its loader.
        -
            identifier: class.nameCase
            paths:
                - application/modules/*
                - application/core/*

        # parent::__construct() in controllers whose base class is loaded at runtime.
        -
            identifier: class.noParent
            paths:
                - application/modules/*
                - application/core/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
