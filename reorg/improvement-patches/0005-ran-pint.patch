+    private function extract_url_key_from_filename(string $filename): ?string
+    {
+        // Match exactly 32 alphanumeric characters followed by underscore
+        if (preg_match('/^([a-zA-Z0-9]{32})_/', $filename, $matches)) {
+            return $matches[1];
+        }
